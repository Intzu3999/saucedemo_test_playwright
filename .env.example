# =========================================================
# Playwright Demo - Environment Configuration (example)
# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.
# =========================================================

# ----- Application Under Test -----
BASE_URL=https://www.saucedemo.com

# ----- Test Credentials (public demo site) -----
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
VALID_PASSWORD=secret_sauce
INVALID_USER=invalid_user
INVALID_PASSWORD=wrong_password

# ----- Playwright Runtime -----
HEADLESS=true
BROWSER=chromium
WORKERS=1
RETRIES=1

# Corporate SSL interception workaround.
# Set to true only if you are behind a corporate proxy that presents a self-
# signed certificate for HTTPS traffic (e.g. Zscaler, Netskope). Keep false in
# CI / on trusted networks.
IGNORE_HTTPS_ERRORS=false

# ----- Public API for bonus API+UI validation -----
DUMMYJSON_BASE_URL=https://dummyjson.com
REQRES_BASE_URL=https://reqres.in/api

# ----- Qase.IO Reporter -----
# Valid QASE_MODE values: off | testops | report
#   off     - reporter disabled (default)
#   testops - publish results to Qase.io cloud (requires token below)
#   report  - write results locally under ./build without uploading
QASE_MODE=off
QASE_TESTOPS_API_TOKEN=your_qase_api_token_here
QASE_TESTOPS_PROJECT=SAUCEPW
QASE_TESTOPS_RUN_TITLE=Playwright Demo Run
QASE_TESTOPS_RUN_COMPLETE=true

# When true (and QASE_MODE=testops), the reporter enables a public share link
# for the completed run and prints it to stdout as:
#   Public report link: https://app.qase.io/public/report/<token>
# The link is view-only, no login required. Off locally by default.
# CI turns this on automatically via the workflow env block.
QASE_TESTOPS_SHOW_PUBLIC_REPORT_LINK=false
