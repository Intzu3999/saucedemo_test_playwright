{
  "name": "playwright_demo",
  "version": "0.1.0",
  "description": "Playwright UI automation framework for saucedemo.com using Page Object Model, with Qase.IO reporting and CI/CD integrations.",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "playwright test",
    "test:ci": "playwright test --grep-invert=@known-bug",
    "test:known-bugs": "playwright test --grep=@known-bug",
    "test:smoke": "playwright test --grep=@smoke",
    "install:browsers": "playwright install --with-deps",
    "qase:cleanup": "node scripts/qase-cleanup.mjs",
    "qase:cleanup:auto": "node scripts/qase-cleanup.mjs --all"
  },
  "keywords": [
    "playwright",
    "automation",
    "e2e",
    "pom",
    "qase",
    "saucedemo"
  ],
  "author": "Evelyn Keoy <intzucareers@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "playwright-qase-reporter": "^2.7.0"
  }
}
