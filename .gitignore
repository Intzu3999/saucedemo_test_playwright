# Dependencies
node_modules/

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# CI reporter log -- teed by GH Actions / Jenkins outside Playwright's
# outputDir so the URL-extraction step can grep it. Never committed.
ci-logs/

# Logs
*.log
npm-debug.log*
# Local diagnostic output (e.g. Qase reporter debug=true dumps, tee'd
# terminal output). Regenerable, sometimes 100s of KB, and leaks local
# file paths / machine names -- never commit.
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary
tmp/
temp/

# docs -- personal working notes stay hidden by default. Reference docs
# meant for reviewers / contributors are whitelisted below.
#
# Committed (reference):
#   docs/test-cases.md
#   docs/about_this_repo/**  (test-data-flow.md, etc.)
#
# Hidden (personal working space):
#   docs/plan.md
#   docs/changelog/**
#   docs/external_learnings/**
#
# NOTE: pattern is "docs/*" (contents), not "docs/" (the directory itself),
# so the whitelist below can re-include specific files/subfolders. Git will
# not re-include files inside a directory that is itself excluded.
docs/*
!docs/test-cases.md